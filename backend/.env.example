STORAGE_MODE=local
# Optional override; the default is backend/data/casefile.db
# CASEFILE_DATABASE_PATH=E:\nclt document\backend\data\casefile.db
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-password
ADMIN_NAME=Casefile Administrator
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# NCLT public e-filing Case History order fetcher. Visible mode keeps unexpected
# portal changes diagnosable; set true after validating automation on a computer.
NCLT_FETCHER_HEADLESS=false
NCLT_FETCHER_BASE_URL=https://efiling.nclt.gov.in
NCLT_FETCHER_DEFAULT_BENCH=indore
NCLT_FETCHER_DEFAULT_CASE_TYPE=16
NCLT_FETCHER_DEFAULT_CASE_TYPE_LABEL=Company Petition IB (IBC)

# Optional AI extraction pilot. The application remains fully operational when
# disabled or when no key is configured. Never expose this key to the frontend.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
AI_PROVIDER=openai
AI_TIMEOUT_SECONDS=120
AI_MAX_DOCUMENT_CHARACTERS=200000

# Groq-hosted open-weight benchmark. Keep the real key only in backend/.env.
# GROQ_BILLING_MODE=free is an explicit declaration that the configured Groq
# project is on the free plan; otherwise actual charged cost remains unknown.
GROQ_API_KEY=
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
GROQ_BILLING_MODE=free
GROQ_DIRECT_DOCUMENT_TOKEN_LIMIT=4000
GROQ_CHUNK_TARGET_TOKENS=1800
