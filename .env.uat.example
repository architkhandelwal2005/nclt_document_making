# Run SETUP_NCLT_UAT.bat instead of copying this file. The setup script
# generates a fresh secret and asks for the first Administrator securely.
CASEFILE_ENVIRONMENT=UAT
CASEFILE_SERVE_FRONTEND=true
CASEFILE_FRONTEND_BUILD_DIR=C:/path/to/nclt-document/frontend/build
CASEFILE_DATA_DIR=C:/path/to/nclt-document/data
CASEFILE_DATABASE_PATH=C:/path/to/nclt-document/data/nclt_uat.db
CASEFILE_DOCUMENTS_DIR=C:/path/to/nclt-document/data/uat_documents
CASEFILE_UAT_PORT=8001
STORAGE_MODE=local
JWT_SECRET=replace-with-a-new-random-secret-of-at-least-32-characters
ADMIN_EMAIL=administrator@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
ADMIN_NAME=UAT Administrator
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_ENABLED=false
